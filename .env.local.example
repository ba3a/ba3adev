# Local settings for the media store (a private Cloudflare R2 bucket). Copy this file to
# .env.local, which git ignores, and fill in the values. Never commit .env.local or put a
# value into this example file. coffer reads these names from the environment first and
# from .env.local second (see coffer.yaml).

# The Cloudflare account that owns the bucket; it is part of the R2 endpoint.
CLOUDFLARE_ACCOUNT_ID=

# An R2 API token with Object Read & Write access to the media bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
