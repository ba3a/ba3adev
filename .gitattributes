# Normalise line endings to LF in the repository and in working trees.
* text=auto eol=lf

# Shell scripts must keep LF, or sh reads the carriage return as part of every command.
*.sh text eol=lf

# Windows scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.jpg binary
*.jpeg binary
*.png binary
*.heic binary
*.heif binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary

# GPX tracks are XML text and stay text (covered by "* text=auto").

# The lock file lists the media originals; keep its line ends the same on every platform.
media.lock.json text eol=lf
