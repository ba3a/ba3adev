{#
  The navigation of ba3a.dev. Everything else on the page is coffer's own
  base.njk, including the wordmark (the site title link) and the theme switch of
  the header; this file only adds the theme stylesheet and the heading font to
  the head and replaces the navigation list (see github.com/ba3a/coffer/blob/v0.1.0/docs/themes.md).
#}
{% extends "coffer:base.njk" %}

{% block head %}
{{ super() }}
{# The favicons of the site. A landing page of a project (see project-tool.njk) links the brand pictures of its project instead, and two sets would leave the choice to the browser. The .ico (sizes="any") is listed first so that browsers which read SVG icons still pick the SVG, which follows the colour scheme of the browser. -#}
{% if 'class="section-marker"' not in (page.content or '') %}
<link rel="icon" href="{{ '/assets/brand/favicon.ico' | url }}" sizes="any">
<link rel="icon" href="{{ '/assets/brand/favicon.svg' | url }}" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ '/assets/brand/apple-touch-icon.png' | url }}">
{% endif %}
<link rel="preload" href="{{ '/assets/fonts/manrope-latin-700.woff2' | url }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/assets/ba3a.css' | url }}">
{% endblock %}

{#- The credit line of the footer links "coffer" to its page on this site. The engine's footer (the license and the credit) is kept with super(), and only the word at the end of the credit is replaced, so the translated text of the line stays the engine's. -#}
{% block footer %}
{{ super() | replace(r/coffer(?=<\/p>)/, '<a href="' + ('/made/coffer/' | url) + '">coffer</a>') | safe }}
{% endblock %}

{% block nav %}
<nav aria-label="{{ 'nav.label' | t }}">
<ul>
{# The wordmark is the link home, so the home entry of the engine's navigation is left out. The Projects entry is there only when the site has projects. -#}
{% for item in nav or [] %}
{% if item.url != '/' %}
{% set href = item.url | url %}
<li><a href="{{ href }}"{% if meta and meta.url == site.baseUrl + href %} aria-current="page"{% endif %}>{{ item.label or (item.key | t) }}</a></li>
{% endif %}
{% endfor %}
</ul>
</nav>
{% endblock %}
