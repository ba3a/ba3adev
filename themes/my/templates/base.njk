{#
  The header of my.ba3a.dev. Everything else on the page is coffer's own
  base.njk, including the site title link and the theme switch; this file adds
  the theme stylesheet and the fonts to the head and replaces the navigation
  block (see github.com/ba3a/coffer/blob/v0.1.0/docs/themes.md). The blocks of the engine are replaceable
  one by one, so the centred header is the engine's markup (title, nav, theme
  switch) plus a tagline printed at the top of the nav block, arranged by the
  stylesheet; the header block itself is not overridden.
#}
{% extends "coffer:base.njk" %}

{% block head %}
{{ super() }}
{# The favicons: the .ico (sizes="any") is listed first so that browsers which read SVG icons still pick the SVG, which follows the colour scheme of the browser. -#}
<link rel="icon" href="{{ '/assets/brand/favicon.ico' | url }}" sizes="any">
<link rel="icon" href="{{ '/assets/brand/favicon.svg' | url }}" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ '/assets/brand/apple-touch-icon.png' | url }}">
<link rel="preload" href="{{ '/assets/fonts/literata-cyrillic-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ '/assets/fonts/literata-cyrillic-700-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/assets/my.css' | url }}">
{% endblock %}

{% block nav %}
{# TODO: rewrite the tagline in the UI strings of the theme (i18n/ru.yaml, site.tagline). -#}
<p class="site-tagline">{{ 'site.tagline' | t }}</p>
<nav aria-label="{{ 'nav.label' | t }}">
<ul>
{# The site title is the link home, so the entries that lead home (the home link and the blog at the root) are left out. This site has no projects, so there is no project navigation; the search entry stays. -#}
{% for item in nav or [] %}
{% if item.url != '/' %}
{% set href = item.url | url %}
<li><a href="{{ href }}"{% if meta and meta.url == site.baseUrl + href %} aria-current="page"{% endif %}>{{ item.label or (item.key | t) }}</a></li>
{% endif %}
{% endfor %}
</ul>
</nav>
{% endblock %}
