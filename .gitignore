content/ba3a.dev/devlog/**/*.[hH][eE][iI][fF]
content/ba3a.dev/devlog/**/*.[wW][eE][bB][pP]
content/ba3a.dev/devlog/**/*.[mM][pP]4
content/ba3a.dev/devlog/**/*.[wW][eE][bB][mM]
content/my.ba3a.dev/**/*.[jJ][pP][gG]
content/my.ba3a.dev/**/*.[jJ][pP][eE][gG]
content/my.ba3a.dev/**/*.[pP][nN][gG]
